# Google Gemini API Key
# Ottienila gratuitamente da Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Modello predefinito (ideale per il piano free: 500 RPD)
# Opzioni consigliate:
# - gemini-2.5-flash-lite (o gemini-3.1-flash-lite se abilitato sul tuo account AI Studio)
# - gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Host & Porta del server
HOST=127.0.0.1
PORT=8000
